# Copy to `.env` and adjust if any host port clashes with something already running.

# --- Host ports ---
KAFKA_PORT=9092
POSTGRES_PORT=5432
MYSQL_PORT=3306
WIREMOCK_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
QTP_METRICS_PORT=9091

# --- Postgres (quality warehouse) ---
POSTGRES_USER=qtp
POSTGRES_PASSWORD=placeholder
POSTGRES_DB=quality

# --- MySQL (ERP) ---
MYSQL_ROOT_PASSWORD=placeholder
MYSQL_DB=erp
MYSQL_USER=qtp
MYSQL_PASSWORD=placeholder

# --- MinIO ---
MINIO_ROOT_USER=minioadmin123
MINIO_ROOT_PASSWORD=placeholder

# --- Grafana ---
GRAFANA_USER=admin321
GRAFANA_PASSWORD=placeholder

# --- Simulator ---
SIM_LINES=line_1,line_2,line_3
SIM_RATE=1
SIM_DEFECT_RATE=0.08
SIM_CRITICAL_EVERY=45

# --- StreamSets Control Hub (for the qtp SDK package) ---
SCH_URL=
# for EU: https://eu02.hub.streamsets.com/
# but for any other region: https://<your-control-hub-region>.hub.streamsets.com/
SCH_CRED_ID=
SCH_TOKEN=
# Obtain SCH_CRED_ID and SCH_TOKEN from your StreamSets Control Hub account
SDC_ID=          # SDC_ID should be the Data Collector (SDC) ID to build on

# --- Real alerting: Microsoft Teams + Jira -----------------------------------------
# IMPORTANT: these are consumed ONLY by `qtp jobs create` (as Control Hub JOB runtime
# parameters, injected when the job is created/started) — never by `qtp pipelines build`.
# The published pipeline definition only ever carries an empty placeholder for these, so
# the real secrets are NEVER baked into the pipeline and NEVER appear in the exported JSON
# under /pipelines (which is committed to git). See docs/PROJECT_REPORT.md for the how-to
# on creating the Teams webhook and Jira API token.
TEAMS_ALERT_WEBHOOK_URL=
JIRA_BASE_URL=
# e.g. https://your-site.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=QUAL
# Must be a valid issue type name in that Jira project (Task/Bug/Story — check your project).
JIRA_ISSUE_TYPE=Task
